{
  "name": "project-vikas",
  "version": "1.0.0",
  "type": "module",
  "description": "Voice-to-Action AI for Rural Empowerment",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "concurrently \"node .next/standalone/server.js\" \"python3 -m uvicorn main:app --host 0.0.0.0 --port 8000\"",
    "server": "uvicorn main:app --host 0.0.0.0 --port 8000",
    "both": "concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "concurrently": "^8.2.0",
    "elevenlabs": "^1.59.0",
    "mongodb": "^7.1.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.9.3",
    "twilio": "^5.12.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "autoprefixer": "^10.0.1",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
